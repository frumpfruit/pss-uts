# ==============================================================================
# SIAKAD CAMPUS PLATFORM - ENVIRONMENT CONFIGURATION
# UDINUS (Universitas Dian Nuswantoro) Academic Operating System
# ==============================================================================

# Global Environment
ENVIRONMENT=
DEBUG=True
SECRET_KEY=siakad-super-secret-key-campus-platform-2026-production-ready

# Database Configuration (PostgreSQL)
POSTGRES_DB=siakad_db
POSTGRES_USER=siakad_admin
POSTGRES_PASSWORD=siakad_secure_password_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery Message Broker
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Microservices Internal URLs & Ports
AUTH_SERVICE_URL=http://auth-service:8001
ACADEMIC_SERVICE_URL=http://academic-service:8002
ENROLLMENT_SERVICE_URL=http://enrollment-service:8003
GRADE_SERVICE_URL=http://grade-service:8004
ATTENDANCE_SERVICE_URL=http://attendance-service:8005
NOTIFICATION_SERVICE_URL=http://notification-service:8006
GATEWAY_URL=http://localhost:8000

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# Academic Configuration Defaults
DEFAULT_MAX_SKS=24
ATTENDANCE_MINIMUM_PERCENTAGE=75.0
ACADEMIC_YEAR_ACTIVE=2025/2026
SEMESTER_ACTIVE=GENAP

# Frontend Vite Settings
VITE_API_BASE_URL=http://localhost:8000/api
VITE_CAMPUS_NAME=Universitas Dian Nuswantoro
VITE_CAMPUS_SHORTNAME=UDINUS
VITE_PLATFORM_NAME=SIAKAD Enterprise Platform
