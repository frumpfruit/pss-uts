# ==============================================================================
# Backend (.gitignore for Django Microservices)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtual Environments
.env
.env.*
!.env.example
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Django Databases & Logs
*.log
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal

# Django Media & Static collected files
media/
staticfiles/
collected_static/

# Unit test & coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Type checking & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Celery & Message Queue
celerybeat-schedule
celerybeat.pid

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# IDEs & Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
